# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Phase 0 only needs the database + vector DB settings; LLM/embedding keys
# come into play in Phase 1.

# ---- LLM (Phase 1+) ----
# Default: Groq (free, hosted, open-source Llama). Get a free key at
# https://console.groq.com  (starts with gsk_). Any OpenAI-compatible backend
# works by changing LLM_BASE_URL + LLM_MODEL:
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
#   Ollama: LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3.2   (no key)
# To use Claude instead: LLM_PROVIDER=anthropic, set ANTHROPIC_API_KEY, LLM_MODEL=claude-sonnet-4-6
# Values must NOT have inline comments — the parser reads them literally.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=0

# ---- Embeddings (Phase 1+) ----
# BGE-M3: 1024-dim, multilingual, ~2.2GB download, slower on CPU.
# Low-disk / low-CPU fallback (change BOTH lines together):
#   EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
#   EMBEDDING_DIM=384
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu

# ---- Vector DB (Qdrant) ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=compliance_chunks

# ---- Relational DB (Postgres) ----
# These credentials must match docker-compose.yml.
DATABASE_URL=postgresql://compliance:compliance@127.0.0.1:5432/compliancegpt

# ---- Reranker (Phase 2+) ----
# Low-disk fallback: cross-encoder/ms-marco-MiniLM-L-6-v2 (~80MB)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---- Observability (Phase 2+) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ---- App ----
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=
RATE_LIMIT_PER_MIN=30
GROUNDEDNESS_THRESHOLD=0.7

# Advanced local retrieval: dense | lexical | pageindex | graph_pageindex
RETRIEVAL_STRATEGY=dense
EVIDENCE_STORAGE_PATH=data/evidence
PAGEINDEX_STORAGE_PATH=data/pageindex
PAGEINDEX_INDEX_MODEL=
PAGEINDEX_NAVIGATION_MODE=local
RETRIEVAL_MAX_DOCUMENTS=5
# Maximum document trees sent to the hosted navigator for one question.
RETRIEVAL_NAVIGATION_DOCUMENTS=1
RETRIEVAL_MAX_PAGES=8
RETRIEVAL_MAX_ROUNDS=3
CACHE_TTL_SECONDS=300

# Serialized indexing calls; provider Retry-After overrides the minimum delay.
PAGEINDEX_MIN_INTERVAL_SECONDS=20
PAGEINDEX_MAX_ATTEMPTS=4
PAGEINDEX_MAX_RETRY_WAIT_SECONDS=120

PAGEINDEX_MAX_OUTPUT_TOKENS=4096

# full = LLM-refined tree; layout = official local extraction without summaries
PAGEINDEX_TREE_MODE=full
