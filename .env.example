# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Phase 0 only needs the database + vector DB settings; LLM/embedding keys
# come into play in Phase 1.

# ---- LLM (Phase 1+) ----
# Default: Groq (free, hosted, open-source Llama). Get a free key at
# https://console.groq.com  (starts with gsk_). Any OpenAI-compatible backend
# works by changing LLM_BASE_URL + LLM_MODEL:
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
#   Ollama: LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3.2   (no key)
# To use Claude instead: LLM_PROVIDER=anthropic, set ANTHROPIC_API_KEY, LLM_MODEL=claude-sonnet-4-6
LLM_PROVIDER=groq               # groq | anthropic | openai | ollama
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=                    # Groq key (gsk_...)
ANTHROPIC_API_KEY=              # only if LLM_PROVIDER=anthropic

# ---- Embeddings (Phase 1+) ----
# MVP uses the small English model (~130MB, 384-dim) to fit on a small disk.
# Production/intended model: BAAI/bge-m3 (1024-dim, multilingual) — set
# EMBEDDING_MODEL=BAAI/bge-m3 and EMBEDDING_DIM=1024 together.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu            # cpu | cuda

# ---- Vector DB (Qdrant) ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=compliance_chunks

# ---- Relational DB (Postgres) ----
# These credentials must match docker-compose.yml.
DATABASE_URL=postgresql://compliance:compliance@localhost:5432/compliancegpt

# ---- Reranker (Phase 2+) ----
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---- Observability (Phase 2+) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ---- App ----
API_HOST=0.0.0.0
API_PORT=8000
RATE_LIMIT_PER_MIN=30
GROUNDEDNESS_THRESHOLD=0.7
