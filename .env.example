# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Phase 0 only needs the database + vector DB settings; LLM/embedding keys
# come into play in Phase 1.

# ---- LLM (Phase 1+) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_MODEL=claude-sonnet-4-6

# ---- Embeddings (Phase 1+) ----
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu            # cpu | cuda

# ---- Vector DB (Qdrant) ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=compliance_chunks

# ---- Relational DB (Postgres) ----
# These credentials must match docker-compose.yml.
DATABASE_URL=postgresql://compliance:compliance@localhost:5432/compliancegpt

# ---- Reranker (Phase 2+) ----
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---- Observability (Phase 2+) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ---- App ----
API_HOST=0.0.0.0
API_PORT=8000
RATE_LIMIT_PER_MIN=30
GROUNDEDNESS_THRESHOLD=0.7
