# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Environment secrets (NEVER commit real keys).
# The glob matters: switching providers creates backups like `.env.groq.bak`,
# which hold live keys just as the original does.
.env
.env.*
!.env.example

# Data & caches (downloaded PDFs, parsed text, model caches)
data/
*.pdf
.cache/
qdrant_storage/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generator output that is merged into evals/golden_dataset.jsonl — committing it
# too would leave two sources of truth for the same rows.
evals/temporal_rows.jsonl

# Test / tooling artifacts
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
